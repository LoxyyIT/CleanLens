<Window x:Class="CleanLens.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:CleanLens.Core.Models;assembly=CleanLens.Core"
        Title="{Binding Texts[AppName]}" Width="1440" Height="920" MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="#F4F8FC" FontFamily="Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#081A2C">
            <DockPanel Margin="18,22">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="5,4,0,34">
                        <Border Width="35" Height="35" CornerRadius="12" Background="#183D5D">
                            <Canvas Width="35" Height="35">
                                <Path Data="M 4,17 C 9,7 25,7 31,17 C 25,27 9,27 4,17 Z" Stroke="#57D2D7" StrokeThickness="2" />
                                <Ellipse Canvas.Left="13" Canvas.Top="12" Width="9" Height="9" Fill="White" />
                                <Path Data="M 21,21 L 28,28" Stroke="#75DDCF" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Canvas>
                        </Border>
                        <StackPanel Margin="11,1,0,0">
                            <TextBlock Text="CleanLens" Foreground="White" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Texts[ProductSubtitle]}" Foreground="#8FA8BF" FontSize="9" FontWeight="Bold" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{Binding Texts[Workspace]}" Foreground="#7890A8" FontSize="10" FontWeight="Bold" Margin="10,0,0,9" />
                    <Button Style="{StaticResource NavButton}" Click="Overview_Click" Margin="0,2"><StackPanel Orientation="Horizontal"><TextBlock Text="◫" Width="28" /><TextBlock Text="{Binding Texts[Overview]}" /></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Click="Applications_Click" Margin="0,2"><StackPanel Orientation="Horizontal"><TextBlock Text="▦" Width="28" /><TextBlock Text="{Binding Texts[Applications]}" /></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Click="Leftovers_Click" Margin="0,2"><StackPanel Orientation="Horizontal"><TextBlock Text="⌕" Width="28" /><TextBlock Text="{Binding Texts[LeftoverReview]}" /></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Click="History_Click" Margin="0,2"><StackPanel Orientation="Horizontal"><TextBlock Text="◷" Width="28" /><TextBlock Text="{Binding Texts[History]}" /></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Click="Quarantine_Click" Margin="0,2"><StackPanel Orientation="Horizontal"><TextBlock Text="▣" Width="28" /><TextBlock Text="{Binding Texts[Quarantine]}" /></StackPanel></Button>
                </StackPanel>
                <Border DockPanel.Dock="Bottom" Background="#102B47" CornerRadius="14" Padding="13" Margin="0,15,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding Texts[Principle]}" Foreground="#73D6D4" FontSize="9" FontWeight="Bold" />
                        <TextBlock Text="{Binding Texts[LocalTagline]}" Foreground="#D0DCE8" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding Texts[LocalOnly]}" Foreground="#89A1B7" FontSize="10" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding Texts[Language]}" Foreground="#AFC1D1" FontSize="10" Margin="0,13,0,4" />
                        <ComboBox SelectedValue="{Binding SelectedLanguage}" SelectedValuePath="Tag" Height="32">
                            <ComboBoxItem Content="English" Tag="en" />
                            <ComboBoxItem Content="Italiano" Tag="it" />
                            <ComboBoxItem Content="Español" Tag="es" />
                            <ComboBoxItem Content="Français" Tag="fr" />
                        </ComboBox>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="30,24,30,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,22">
                <Button DockPanel.Dock="Right" Content="{Binding Texts[ScanApplications]}" Command="{Binding ScanCommand}" Style="{StaticResource PrimaryButton}" />
                <StackPanel>
                    <TextBlock Text="{Binding PageTitle}" FontSize="27" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding PageSubtitle}" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="17,14"><StackPanel><TextBlock Text="{Binding Texts[InstalledApps]}" FontSize="10" Foreground="{StaticResource MutedBrush}" FontWeight="Bold" /><TextBlock Text="{Binding AppCountText}" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0" /></StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="17,14"><StackPanel><TextBlock Text="{Binding Texts[ReportedAppSize]}" FontSize="10" Foreground="{StaticResource MutedBrush}" FontWeight="Bold" /><TextBlock Text="{Binding TotalSizeText}" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0" /><TextBlock Text="{Binding Texts[ReportedEstimateNote]}" FontSize="9" Foreground="{StaticResource MutedBrush}" /></StackPanel></Border>
                <Border Grid.Column="4" Style="{StaticResource Card}" Padding="17,14"><StackPanel><TextBlock Text="{Binding Texts[CandidatesFound]}" FontSize="10" Foreground="{StaticResource MutedBrush}" FontWeight="Bold" /><TextBlock Text="{Binding LeftoversText}" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0" /></StackPanel></Border>
            </Grid>
            <Grid Grid.Row="2" x:Name="ApplicationWorkspace">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,15">
                            <ComboBox x:Name="FilterCombo" DockPanel.Dock="Right" Width="155" Height="36" SelectedIndex="0" SelectionChanged="Filter_Changed">
                                <ComboBoxItem Content="{Binding Texts[AllApplications]}" />
                                <ComboBoxItem Content="{Binding Texts[WithoutUninstaller]}" />
                                <ComboBoxItem Content="{Binding Texts[UnknownPublisher]}" />
                            </ComboBox>
                            <TextBox x:Name="SearchBox" Width="280" Height="36" Padding="11,7" VerticalContentAlignment="Center" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" TextChanged="Search_Changed" ToolTip="{Binding Texts[SearchTooltip]}" />
                        </DockPanel>
                        <DataGrid x:Name="ApplicationsDataGrid" Grid.Row="1" ItemsSource="{Binding VisibleApplications}" SelectedItem="{Binding SelectedApplication, Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="55" ColumnHeaderHeight="37" Background="White">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="APPLICATION" Binding="{Binding Name}" Width="2*" />
                                <DataGridTextColumn Header="PUBLISHER" Binding="{Binding Publisher}" Width="*" />
                                <DataGridTextColumn Header="VERSION" Binding="{Binding Version}" Width="*" />
                                <DataGridTemplateColumn Header="SIZE · EST." Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding EstimatedSizeText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EstimatedSizeKilobytes}" Value="{x:Null}">
                                                                <Setter Property="Text" Value="{Binding DataContext.Texts[SizeNotReported], RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Width="48" Height="48" CornerRadius="16" Background="#EAF2FF" HorizontalAlignment="Left">
                                <Canvas Width="35" Height="35" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="M 3,17 C 9,6 26,6 32,17 C 26,28 9,28 3,17 Z" Stroke="{StaticResource BlueBrush}" StrokeThickness="2" />
                                    <Ellipse Canvas.Left="13" Canvas.Top="12" Width="9" Height="9" Fill="{StaticResource InkBrush}" />
                                    <Path Data="M 21,21 L 28,28" Stroke="{StaticResource TealBrush}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Canvas>
                            </Border>
                            <TextBlock Text="{Binding SelectedApplicationDisplayName}" FontSize="23" FontWeight="SemiBold" Margin="0,16,0,3" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedPublisher}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                            <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,18" />
                            <TextBlock Text="{Binding Texts[ApplicationDetails]}" FontSize="10" Foreground="{StaticResource MutedBrush}" FontWeight="Bold" />
                            <TextBlock Text="{Binding DetailVersion}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding DetailLocation}" FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding DetailSource}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0" />
                            <Expander Header="{Binding Texts[AdvancedDetails]}" Margin="0,14,0,0">
                                <StackPanel Margin="0,9,0,0">
                                    <TextBlock Text="{Binding Texts[UninstallCommand]}" FontWeight="SemiBold" FontSize="11" />
                                    <TextBlock Text="{Binding SelectedApplication.UninstallCommand}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,9" />
                                    <TextBlock Text="{Binding Texts[RegistryIdentity]}" FontWeight="SemiBold" FontSize="11" />
                                    <TextBlock Text="{Binding SelectedApplication.RegistryKeyPath}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,9" />
                                </StackPanel>
                            </Expander>
                            <Border Background="#F2F7FC" CornerRadius="12" Padding="13" Margin="0,15,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Texts[PersonalDataOut]}" Foreground="#177C75" FontWeight="Bold" FontSize="9" />
                                    <TextBlock Text="{Binding Texts[PersonalDataMessage]}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <Button Content="{Binding Texts[RunUninstaller]}" Click="Uninstall_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Margin="0,18,0,0" />
                            <Button Content="{Binding Texts[ReviewLeftovers]}" Click="Leftovers_Click" Margin="0,8,0,0" Padding="13,9" />
                            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,11,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
            <Border Grid.Row="2" x:Name="LeftoverWorkspace" Style="{StaticResource Card}" Visibility="Collapsed">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
                        <Button Content="{Binding Texts[ScanSelectedApplication]}" Command="{Binding ScanLeftoversCommand}" Style="{StaticResource PrimaryButton}" />
                        <Button Content="{Binding Texts[MoveToQuarantine]}" Click="QuarantineSelected_Click" Margin="10,0,0,0" Padding="14,9" />
                    </StackPanel>
                    <DataGrid x:Name="LeftoversDataGrid" ItemsSource="{Binding Leftovers}" SelectedItem="{Binding SelectedLeftover, Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PATH" Binding="{Binding Path}" Width="3*" />
                            <DataGridTextColumn Header="SIZE" Binding="{Binding SizeText}" Width="90" />
                            <DataGridTemplateColumn Header="TYPE" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource LocalizationValueConverter}" ConverterParameter="Category">
                                                    <Binding Path="Category" />
                                                    <Binding Path="DataContext.Texts.Language" RelativeSource="{RelativeSource AncestorType={x:Type DataGrid}}" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="CONFIDENCE" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource LocalizationValueConverter}" ConverterParameter="Confidence">
                                                    <Binding Path="Confidence" />
                                                    <Binding Path="DataContext.Texts.Language" RelativeSource="{RelativeSource AncestorType={x:Type DataGrid}}" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="REASON" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock TextWrapping="Wrap">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource LocalizationValueConverter}" ConverterParameter="Candidate">
                                                    <Binding Path="ReasonKey" />
                                                    <Binding Path="DataContext.Texts.Language" RelativeSource="{RelativeSource AncestorType={x:Type DataGrid}}" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
            <Border Grid.Row="2" x:Name="HistoryWorkspace" Style="{StaticResource Card}" Visibility="Collapsed">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Texts[HistoryTitle]}" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,14" />
                    <ListBox ItemsSource="{Binding HistoryEntries}" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="5,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="{Binding ApplicationName}" FontWeight="SemiBold" /><TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"><Run Text="{Binding Operation}" /><Run Text=" · " /><Run Text="{Binding Result}" /></TextBlock></StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding CreatedAt, StringFormat={}{0:g}}" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center" Margin="12,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <Border Grid.Row="2" x:Name="QuarantineWorkspace" Style="{StaticResource Card}" Visibility="Collapsed">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="{Binding Texts[QuarantinedFolders]}" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Content="{Binding Texts[RestoreSelected]}" Click="RestoreSelected_Click" Margin="18,0,0,0" Padding="14,9" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding QuarantineEntries}" SelectedItem="{Binding SelectedQuarantine, Mode=TwoWay}" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="5,12">
                                    <StackPanel><TextBlock Text="{Binding ApplicationName}" FontWeight="SemiBold" /><TextBlock Text="{Binding OriginalPath}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap" /><TextBlock Text="{Binding CreatedAt, StringFormat={}{0:g}}" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" /></StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <Border Grid.RowSpan="3" Background="#99081A2C" Visibility="{Binding DisclaimerVisibility}">
                <Border Width="560" Padding="30" Background="White" CornerRadius="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="{Binding Texts[SafetyTitle]}" FontSize="23" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Texts[SafetyBody]}" Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,12,0,16" />
                        <CheckBox IsChecked="{Binding SafetyAccepted}" FontSize="12"><TextBlock Text="{Binding Texts[SafetyCheck]}" TextWrapping="Wrap" Width="470" /></CheckBox>
                        <Button Content="{Binding Texts[Continue]}" Command="{Binding AcceptSafetyCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="0,20,0,0" />
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>
