<Window x:Class="CleanLens.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:CleanLens.Core.Models;assembly=CleanLens.Core"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding Texts[AppName]}" Icon="/CleanLens;component/Assets/CleanLens.ico" Width="1490" Height="940" MinWidth="1160" MinHeight="740"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="#EDF3FA" Foreground="{StaticResource InkBrush}" FontFamily="Segoe UI" StateChanged="Window_StateChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Row="0" Grid.ColumnSpan="2" BorderBrush="#24506C" BorderThickness="0,0,0,1" shell:WindowChrome.IsHitTestVisibleInChrome="False">
            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#071725" Offset="0" /><GradientStop Color="#0E2B43" Offset="0.62" /><GradientStop Color="#123A50" Offset="1" /></LinearGradientBrush></Border.Background>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="13,0,0,0">
                    <Border Width="25" Height="25" CornerRadius="8" Background="#15344D" BorderBrush="#2A506A" BorderThickness="1" Padding="2">
                        <Image Source="/CleanLens;component/logo.png" Stretch="Uniform" />
                    </Border>
                    <TextBlock Text="CleanLens" Foreground="#F2F7FC" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="9,0,0,0" />
                    <Border Background="#1A4258" BorderBrush="#2A6075" BorderThickness="1" CornerRadius="7" Padding="8,4" Margin="11,0,0,0">
                        <TextBlock Text="{Binding Texts[ProductSubtitle]}" Foreground="#89A7BF" FontSize="8" FontWeight="Bold" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="MinimizeWindowButton" Style="{StaticResource WindowCaptionButton}" Click="WindowMinimize_Click" AutomationProperties.Name="{Binding Texts[WindowMinimize]}" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                    </Button>
                    <Button x:Name="MaximizeWindowButton" Style="{StaticResource WindowCaptionButton}" Click="WindowMaximizeRestore_Click" AutomationProperties.Name="{Binding Texts[WindowMaximize]}" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock x:Name="MaximizeWindowGlyph" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                    </Button>
                    <Button x:Name="CloseWindowButton" Style="{StaticResource WindowCloseButton}" Click="WindowClose_Click" AutomationProperties.Name="{Binding Texts[WindowClose]}" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Grid.Column="0" BorderBrush="#19354E" BorderThickness="0,0,1,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#071827" Offset="0" />
                    <GradientStop Color="#0A2034" Offset="0.58" />
                    <GradientStop Color="#081A2B" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel Margin="17,22,17,18" LastChildFill="False">
                <Border DockPanel.Dock="Bottom" Background="#0E273D" BorderBrush="#1B3B55" BorderThickness="1" CornerRadius="16" Padding="13" Margin="0,13,0,0">
                    <StackPanel>
                        <Border HorizontalAlignment="Left" Background="#143550" CornerRadius="8" Padding="8,5">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="#55D1C8" VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBlock Text="{Binding Texts[LocalOnly]}" Foreground="#C3D7E7" FontSize="9" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding Texts[Principle]}" Foreground="#66D4D0" FontSize="8" FontWeight="Bold" Margin="1,13,0,0" />
                        <TextBlock Text="{Binding Texts[LocalTagline]}" Foreground="#D7E3ED" FontSize="11" TextWrapping="Wrap" LineHeight="16" Margin="1,5,0,0" />
                        <Button Click="OpenGitHub_Click" HorizontalAlignment="Stretch" Margin="0,13,0,0" Padding="10,8" Background="#163650" BorderBrush="#294A64" BorderThickness="1" Foreground="#DCEAF5" FontSize="11" FontWeight="SemiBold" Cursor="Hand">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="25" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#83B4D4" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="GitHub" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="↗" Foreground="#83B4D4" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>
                <Button x:Name="SettingsNav" DockPanel.Dock="Bottom" Style="{StaticResource NavButton}" Click="Settings_Click" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="11" Background="#122B41" Margin="0,0,12,0">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#AFC2D3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding Texts[Settings]}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Border DockPanel.Dock="Bottom" Height="1" Background="#20394F" Margin="0,12,0,0" />
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="3,2,0,27">
                        <Border Width="48" Height="48" CornerRadius="15" Background="#163852" BorderBrush="#2B526D" BorderThickness="1" Padding="3">
                            <Image Source="/CleanLens;component/logo.png" Stretch="Uniform" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="CleanLens" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Texts[ProductSubtitle]}" Foreground="#8FA8BF" FontSize="8" FontWeight="Bold" Margin="1,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Texts[Workspace]}" Foreground="#7890A8" FontSize="9" FontWeight="Bold" Margin="10,0,10,0" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Height="1" Background="#1C354A" VerticalAlignment="Center" Margin="5,0,4,0" />
                    </Grid>
                    <Button x:Name="ApplicationsNav" Style="{StaticResource NavButton}" Click="Applications_Click" Margin="0,2">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="11" Background="#122B41" Margin="0,0,12,0"><TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            <TextBlock Text="{Binding Texts[Applications]}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="LeftoversNav" Style="{StaticResource NavButton}" Click="Leftovers_Click" Margin="0,2">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="11" Background="#122B41" Margin="0,0,12,0"><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            <TextBlock Text="{Binding Texts[LeftoverReview]}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="HistoryNav" Style="{StaticResource NavButton}" Click="History_Click" Margin="0,2">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="11" Background="#122B41" Margin="0,0,12,0"><TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            <TextBlock Text="{Binding Texts[History]}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="DiskNav" Style="{StaticResource NavButton}" Click="Disk_Click" Margin="0,2">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="11" Background="#122B41" Margin="0,0,12,0"><TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            <TextBlock Text="{Binding Texts[Disk]}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="AnalysisNav" Style="{StaticResource NavButton}" Click="Analysis_Click" Margin="0,2">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="11" Background="#122B41" Margin="0,0,12,0"><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            <TextBlock Text="{Binding Texts[Analysis]}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Grid Margin="0,22,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Texts[Protection]}" Foreground="#7890A8" FontSize="9" FontWeight="Bold" Margin="10,0,10,0" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Height="1" Background="#1C354A" VerticalAlignment="Center" Margin="5,0,4,0" />
                    </Grid>
                    <Button x:Name="QuarantineNav" Style="{StaticResource NavButton}" Click="Quarantine_Click" Margin="0,2">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="11" Background="#122B41" Margin="0,0,12,0"><TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            <TextBlock Text="{Binding Texts[Quarantine]}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1" Grid.Column="1" Margin="29,25,29,27">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,23">
                <Button x:Name="HeaderScanButton" DockPanel.Dock="Right" Content="{Binding Texts[ScanApplications]}" Command="{Binding ScanCommand}" Style="{StaticResource PrimaryButton}" />
                <Button DockPanel.Dock="Right" Content="{Binding Texts[ExportReport]}" Click="ExportReport_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" />
                <StackPanel>
                    <TextBlock Text="{Binding PageTitle}" FontSize="31" FontWeight="Bold" />
                    <TextBlock Text="{Binding PageSubtitle}" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="1,5,0,0" />
                </StackPanel>
            </DockPanel>
            <Grid x:Name="SummaryMetrics" Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="17,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="47" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="38" Height="38" CornerRadius="12" Background="#EAF0FF" VerticalAlignment="Center"><TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource BlueBrush}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Texts[InstalledApps]}" FontSize="10" Foreground="{StaticResource MutedBrush}" FontWeight="Bold" /><TextBlock Text="{Binding AppCountText}" FontSize="23" FontWeight="Bold" Margin="0,3,0,0" /></StackPanel></Grid></Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="17,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="47" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="38" Height="38" CornerRadius="12" Background="#E5F8F6" VerticalAlignment="Center"><TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource TealBrush}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Texts[ReportedAppSize]}" FontSize="10" Foreground="{StaticResource MutedBrush}" FontWeight="Bold" /><TextBlock Text="{Binding TotalSizeText}" FontSize="23" FontWeight="Bold" Margin="0,3,0,0" /><TextBlock Text="{Binding Texts[ReportedEstimateNote]}" FontSize="9" Foreground="{StaticResource MutedBrush}" /></StackPanel></Grid></Border>
                <Border Grid.Column="4" Style="{StaticResource Card}" Padding="17,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="47" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="38" Height="38" CornerRadius="12" Background="#E8F7F9" VerticalAlignment="Center"><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource CyanBrush}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Texts[CandidatesFound]}" FontSize="10" Foreground="{StaticResource MutedBrush}" FontWeight="Bold" /><TextBlock Text="{Binding LeftoversText}" FontSize="23" FontWeight="Bold" Margin="0,3,0,0" /></StackPanel></Grid></Border>
            </Grid>
            <Grid Grid.Row="2" x:Name="ApplicationWorkspace">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="310" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid Margin="0,0,0,15">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="235" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="158" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="184" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SearchBox" Grid.Column="0" Height="38" Padding="11,0" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" TextChanged="Search_Changed" ToolTip="{Binding Texts[SearchTooltip]}" />
                            <ComboBox x:Name="SearchScopeCombo" Grid.Column="2" Height="38" SelectedIndex="0" SelectionChanged="SearchScope_Changed">
                                <ComboBoxItem Content="{Binding Texts[SearchAllFields]}" />
                                <ComboBoxItem Content="{Binding Texts[SearchName]}" />
                                <ComboBoxItem Content="{Binding Texts[SearchPublisher]}" />
                                <ComboBoxItem Content="{Binding Texts[SearchVersion]}" />
                                <ComboBoxItem Content="{Binding Texts[SearchLocation]}" />
                            </ComboBox>
                            <ComboBox x:Name="FilterCombo" Grid.Column="4" Width="184" Height="38" HorizontalAlignment="Right" SelectedIndex="0" SelectionChanged="Filter_Changed">
                                <ComboBoxItem Content="{Binding Texts[AllApplications]}" />
                                <ComboBoxItem Content="{Binding Texts[HasUninstaller]}" />
                                <ComboBoxItem Content="{Binding Texts[WithoutUninstaller]}" />
                                <ComboBoxItem Content="{Binding Texts[KnownPublisher]}" />
                                <ComboBoxItem Content="{Binding Texts[UnknownPublisher]}" />
                                <ComboBoxItem Content="{Binding Texts[ReportedSize]}" />
                                <ComboBoxItem Content="{Binding Texts[UnreportedSize]}" />
                            </ComboBox>
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="5" Text="{Binding Texts[MultiSelectionHint]}" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="1,8,0,0" />
                        </Grid>
                        <DataGrid x:Name="ApplicationsDataGrid" Grid.Row="1" ItemsSource="{Binding VisibleApplications}" SelectedItem="{Binding SelectedApplication, Mode=TwoWay}" SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="Applications_SelectionChanged" PreviewMouseLeftButtonDown="ApplicationsDataGrid_PreviewMouseLeftButtonDown" AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="True" Sorting="ApplicationsDataGrid_Sorting" ColumnHeaderStyle="{StaticResource SortableColumnHeader}" IsReadOnly="True" HeadersVisibility="Column" RowHeight="70" AlternationCount="2" ColumnHeaderHeight="44" Background="Transparent">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="✓" Width="42" CanUserSort="False" HeaderStyle="{StaticResource NonSortableColumnHeader}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}, Path=IsSelected, Mode=TwoWay}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{Binding DataContext.Texts[SelectApplicationTooltip], RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="54" CanUserSort="False" HeaderStyle="{StaticResource NonSortableColumnHeader}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Width="40" Height="40" CornerRadius="12" Background="#EDF4FF" BorderBrush="#DCE8F6" BorderThickness="1" HorizontalAlignment="Center" AutomationProperties.Name="{Binding Name}">
                                                <Grid>
                                                    <TextBlock Text="{Binding Name, Converter={StaticResource ApplicationMonogramConverter}}" Foreground="{StaticResource BlueBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <Image Source="{Binding DisplayIcon, Converter={StaticResource ApplicationIconConverter}}" Stretch="Uniform" Margin="6" RenderOptions.BitmapScalingMode="HighQuality" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="APPLICATION" SortMemberPath="Name" Width="2.5*" MinWidth="210">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" /><TextBlock Text="{Binding Source}" FontSize="10" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="PUBLISHER" SortMemberPath="Publisher" Binding="{Binding Publisher}" ElementStyle="{StaticResource PublisherCell}" Width="1.6*" MinWidth="160" />
                                <DataGridTextColumn Header="VERSION" SortMemberPath="Version" Binding="{Binding Version}" ElementStyle="{StaticResource VersionCell}" Width="112" />
                                <DataGridTemplateColumn Header="SIZE · EST." SortMemberPath="EstimatedSizeKilobytes" Width="116">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border x:Name="ApplicationSizeBadge" Background="#F1F5FB" BorderBrush="#E2EAF4" BorderThickness="1" CornerRadius="8" Padding="8,4" Width="94" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Grid>
                                                    <TextBlock x:Name="ReportedSizeText" Text="{Binding EstimatedSizeText}" FontSize="10" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="MissingSizeText" Text="—" FontSize="10" Foreground="{StaticResource MutedBrush}" TextAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" ToolTip="{Binding DataContext.Texts[SizeNotReported], RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding EstimatedSizeKilobytes}" Value="{x:Null}">
                                                    <Setter TargetName="ReportedSizeText" Property="Visibility" Value="Collapsed" />
                                                    <Setter TargetName="MissingSizeText" Property="Visibility" Value="Visible" />
                                                    <Setter TargetName="ApplicationSizeBadge" Property="Background" Value="#F7F9FC" />
                                                    <Setter TargetName="ApplicationSizeBadge" Property="BorderBrush" Value="#E8EDF3" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Row="1" Background="#FFFCFE" CornerRadius="14" Margin="8" Visibility="{Binding InventoryEmptyStateVisibility}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="390">
                                <Border Width="54" Height="54" CornerRadius="17" Background="{StaticResource AccentSoft}" HorizontalAlignment="Center" Margin="0,0,0,16">
                                    <TextBlock Text="⌕" FontSize="29" Foreground="{StaticResource BlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding InventoryEmptyTitle}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" />
                                <TextBlock Text="{Binding InventoryEmptyCopy}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,7,0,18" />
                                <Button Content="{Binding Texts[ScanApplications]}" Command="{Binding ScanCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Center" Visibility="{Binding InventoryEmptyScanVisibility}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Width="58" Height="58" CornerRadius="18" Background="#EAF2FF" BorderBrush="#D6E4FC" BorderThickness="1" HorizontalAlignment="Left">
                                <Grid><TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="23" Foreground="{StaticResource BlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /><Image Source="{Binding SelectedApplication.DisplayIcon, Converter={StaticResource ApplicationIconConverter}}" Stretch="Uniform" Margin="9" RenderOptions.BitmapScalingMode="HighQuality" /></Grid>
                            </Border>
                            <TextBlock Text="{Binding SelectedApplicationDisplayName}" FontSize="23" FontWeight="SemiBold" Margin="0,16,0,3" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedPublisher}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                            <Border Background="#EEF4FF" BorderBrush="#D8E5F8" BorderThickness="1" CornerRadius="9" Padding="10,8" Margin="0,10,0,0" Visibility="{Binding MultiSelectionVisibility}">
                                <TextBlock Text="{Binding SelectedApplicationsSummary}" FontSize="10" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" MaxHeight="90" />
                            </Border>
                            <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,18" />
                            <TextBlock Text="{Binding Texts[ApplicationDetails]}" FontSize="10" Foreground="{StaticResource MutedBrush}" FontWeight="Bold" />
                            <TextBlock Text="{Binding DetailVersion}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding DetailLocation}" FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding DetailSource}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0" />
                            <Button Content="{Binding Texts[MeasureDiskUsage]}" Click="MeasureDiskUsage_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" Margin="0,10,0,0" />
                            <Expander Header="{Binding Texts[AdvancedDetails]}" Margin="0,14,0,0">
                                <StackPanel Margin="0,9,0,0">
                                    <TextBlock Text="{Binding Texts[UninstallCommand]}" FontWeight="SemiBold" FontSize="11" />
                                    <TextBlock Text="{Binding SelectedApplication.UninstallCommand}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,9" />
                                    <TextBlock Text="{Binding Texts[RegistryIdentity]}" FontWeight="SemiBold" FontSize="11" />
                                    <TextBlock Text="{Binding SelectedApplication.RegistryKeyPath}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,9" />
                                </StackPanel>
                            </Expander>
                            <Border Background="#F2F7FC" CornerRadius="12" Padding="13" Margin="0,15,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Texts[PersonalDataOut]}" Foreground="#177C75" FontWeight="Bold" FontSize="9" />
                                    <TextBlock Text="{Binding Texts[PersonalDataMessage]}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <Button Content="{Binding UninstallButtonText}" Click="Uninstall_Click" IsEnabled="{Binding CanUninstallSelected}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Margin="0,18,0,0" />
                            <Button Content="{Binding Texts[ReviewLeftovers]}" Click="Leftovers_Click" IsEnabled="{Binding CanReviewLeftovers}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" Margin="0,8,0,0" />
                            <Button Content="{Binding ManualDeleteButtonText}" Click="ManualDelete_Click" IsEnabled="{Binding CanManualDeleteSelected}" Style="{StaticResource SecondaryButton}" Background="#B4233D" BorderBrush="#B4233D" Foreground="White" HorizontalAlignment="Stretch" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,11,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
            <Border Grid.Row="2" x:Name="LeftoverWorkspace" Style="{StaticResource Card}" Visibility="Collapsed">
                <DockPanel>
