<Window x:Class="CleanLens.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:CleanLens.Core.Models;assembly=CleanLens.Core"
        Title="CleanLens" Width="1440" Height="920" MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="#F4F8FC" FontFamily="Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#081A2C">
            <DockPanel Margin="18,22">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="5,4,0,34">
                        <Border Width="35" Height="35" CornerRadius="12" Background="#183D5D">
                            <Canvas Width="35" Height="35">
                                <Path Data="M 4,17 C 9,7 25,7 31,17 C 25,27 9,27 4,17 Z" Stroke="#57D2D7" StrokeThickness="2" />
                                <Ellipse Canvas.Left="13" Canvas.Top="12" Width="9" Height="9" Fill="White" />
                                <Path Data="M 21,21 L 28,28" Stroke="#75DDCF" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Canvas>
                        </Border>
                        <StackPanel Margin="11,1,0,0">
                            <TextBlock Text="CleanLens" Foreground="White" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="WINDOWS CLEANUP" Foreground="#8FA8BF" FontSize="9" FontWeight="Bold" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="WORKSPACE" Foreground="#7890A8" FontSize="10" FontWeight="Bold" Margin="10,0,0,9" />
                    <Button Style="{StaticResource NavButton}" Click="Overview_Click" Margin="0,2"><StackPanel Orientation="Horizontal"><TextBlock Text="◫" Width="28" /><TextBlock Text="Overview" /></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Click="Applications_Click" Margin="0,2"><StackPanel Orientation="Horizontal"><TextBlock Text="▦" Width="28" /><TextBlock Text="Applications" /></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Click="Leftovers_Click" Margin="0,2"><StackPanel Orientation="Horizontal"><TextBlock Text="⌕" Width="28" /><TextBlock Text="Leftover review" /></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Click="History_Click" Margin="0,2"><StackPanel Orientation="Horizontal"><TextBlock Text="◷" Width="28" /><TextBlock Text="History" /></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Click="Quarantine_Click" Margin="0,2"><StackPanel Orientation="Horizontal"><TextBlock Text="▣" Width="28" /><TextBlock Text="Quarantine" /></StackPanel></Button>
                </StackPanel>
                <Border DockPanel.Dock="Bottom" Background="#102B47" CornerRadius="14" Padding="13" Margin="0,15,0,0">
                    <StackPanel>
                        <TextBlock Text="SHOW FIRST. DELETE SECOND." Foreground="#73D6D4" FontSize="9" FontWeight="Bold" />
                        <TextBlock Text="Review every path before it leaves your PC." Foreground="#D0DCE8" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock Text="Local only · no telemetry" Foreground="#89A1B7" FontSize="10" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="30,24,30,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,22">
                <Button DockPanel.Dock="Right" Content="Scan applications" Command="{Binding ScanCommand}" Style="{StaticResource PrimaryButton}" />
                <StackPanel>
                    <TextBlock Text="{Binding PageTitle}" FontSize="27" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding PageSubtitle}" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="17,14"><StackPanel><TextBlock Text="INSTALLED APPS" FontSize="10" Foreground="{StaticResource MutedBrush}" FontWeight="Bold" /><TextBlock Text="{Binding AppCountText}" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0" /></StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="17,14"><StackPanel><TextBlock Text="REPORTED APP SIZE" FontSize="10" Foreground="{StaticResource MutedBrush}" FontWeight="Bold" /><TextBlock Text="{Binding TotalSizeText}" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0" /><TextBlock Text="Registry estimates only; missing sizes are excluded." FontSize="9" Foreground="{StaticResource MutedBrush}" /></StackPanel></Border>
                <Border Grid.Column="4" Style="{StaticResource Card}" Padding="17,14"><StackPanel><TextBlock Text="CANDIDATES FOUND" FontSize="10" Foreground="{StaticResource MutedBrush}" FontWeight="Bold" /><TextBlock Text="{Binding LeftoversText}" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0" /></StackPanel></Border>
            </Grid>
            <Grid Grid.Row="2" x:Name="ApplicationWorkspace">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,15">
                            <ComboBox DockPanel.Dock="Right" Width="155" Height="36" SelectedIndex="0" SelectionChanged="Filter_Changed">
                                <ComboBoxItem Content="All applications" />
                                <ComboBoxItem Content="Without uninstaller" />
                                <ComboBoxItem Content="Unknown publisher" />
                            </ComboBox>
                            <TextBox x:Name="SearchBox" Width="280" Height="36" Padding="11,7" VerticalContentAlignment="Center" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" TextChanged="Search_Changed" ToolTip="Search name, publisher, version, install path or executable" />
                        </DockPanel>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding VisibleApplications}" SelectedItem="{Binding SelectedApplication, Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="55" ColumnHeaderHeight="37" Background="White">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="APPLICATION" Binding="{Binding Name}" Width="2*" />
                                <DataGridTextColumn Header="PUBLISHER" Binding="{Binding Publisher}" Width="*" />
                                <DataGridTextColumn Header="VERSION" Binding="{Binding Version}" Width="*" />
                                <DataGridTextColumn Header="SIZE · EST." Binding="{Binding EstimatedSizeText}" Width="110" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Width="48" Height="48" CornerRadius="16" Background="#EAF2FF" HorizontalAlignment="Left">
                                <Canvas Width="35" Height="35" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="M 3,17 C 9,6 26,6 32,17 C 26,28 9,28 3,17 Z" Stroke="{StaticResource BlueBrush}" StrokeThickness="2" />
                                    <Ellipse Canvas.Left="13" Canvas.Top="12" Width="9" Height="9" Fill="{StaticResource InkBrush}" />
                                    <Path Data="M 21,21 L 28,28" Stroke="{StaticResource TealBrush}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Canvas>
                            </Border>
                            <TextBlock Text="{Binding SelectedApplication.Name, TargetNullValue=Select an application}" FontSize="23" FontWeight="SemiBold" Margin="0,16,0,3" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedApplication.Publisher, TargetNullValue=Publisher not listed}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                            <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,18" />
                            <TextBlock Text="APPLICATION DETAILS" FontSize="10" Foreground="{StaticResource MutedBrush}" FontWeight="Bold" />
                            <TextBlock Text="{Binding DetailVersion}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding DetailLocation}" FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding DetailSource}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0" />
                            <Expander Header="Advanced details" Margin="0,14,0,0">
                                <StackPanel Margin="0,9,0,0">
                                    <TextBlock Text="Uninstall command" FontWeight="SemiBold" FontSize="11" />
                                    <TextBlock Text="{Binding SelectedApplication.UninstallCommand}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,9" />
                                    <TextBlock Text="Registry identity" FontWeight="SemiBold" FontSize="11" />
                                    <TextBlock Text="{Binding SelectedApplication.RegistryKeyPath}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,9" />
                                </StackPanel>
                            </Expander>
                            <Border Background="#F2F7FC" CornerRadius="12" Padding="13" Margin="0,15,0,0">
                                <StackPanel>
                                    <TextBlock Text="PERSONAL DATA STAYS OUT OF SCOPE" Foreground="#177C75" FontWeight="Bold" FontSize="9" />
                                    <TextBlock Text="Documents, projects, saves and other user files are not included in this scan." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <Button Content="Run registered uninstaller" Click="Uninstall_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Margin="0,18,0,0" />
                            <Button Content="Review associated leftovers" Click="Leftovers_Click" Margin="0,8,0,0" Padding="13,9" />
                            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,11,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
            <Border Grid.Row="2" x:Name="LeftoverWorkspace" Style="{StaticResource Card}" Visibility="Collapsed">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
                        <Button Content="Scan selected application" Command="{Binding ScanLeftoversCommand}" Style="{StaticResource PrimaryButton}" />
                        <Button Content="Move selected folder to quarantine" Click="QuarantineSelected_Click" Margin="10,0,0,0" Padding="14,9" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Leftovers}" SelectedItem="{Binding SelectedLeftover, Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PATH" Binding="{Binding Path}" Width="3*" />
                            <DataGridTextColumn Header="SIZE" Binding="{Binding SizeText}" Width="90" />
                            <DataGridTextColumn Header="TYPE" Binding="{Binding Category}" Width="*" />
                            <DataGridTextColumn Header="CONFIDENCE" Binding="{Binding Confidence}" Width="*" />
                            <DataGridTextColumn Header="REASON" Binding="{Binding Reason}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
            <Border Grid.Row="2" x:Name="HistoryWorkspace" Style="{StaticResource Card}" Visibility="Collapsed">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Local operation history" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,14" />
                    <ListBox ItemsSource="{Binding HistoryEntries}" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="5,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="{Binding ApplicationName}" FontWeight="SemiBold" /><TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"><Run Text="{Binding Operation}" /><Run Text=" · " /><Run Text="{Binding Result}" /></TextBlock></StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding CreatedAt, StringFormat={}{0:g}}" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center" Margin="12,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <Border Grid.Row="2" x:Name="QuarantineWorkspace" Style="{StaticResource Card}" Visibility="Collapsed">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="Quarantined folders" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Content="Restore selected" Click="RestoreSelected_Click" Margin="18,0,0,0" Padding="14,9" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding QuarantineEntries}" SelectedItem="{Binding SelectedQuarantine, Mode=TwoWay}" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="5,12">
                                    <StackPanel><TextBlock Text="{Binding ApplicationName}" FontWeight="SemiBold" /><TextBlock Text="{Binding OriginalPath}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap" /><TextBlock Text="{Binding CreatedAt, StringFormat={}{0:g}}" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" /></StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <Border Grid.RowSpan="3" Background="#99081A2C" Visibility="{Binding DisclaimerVisibility}">
                <Border Width="560" Padding="30" Background="White" CornerRadius="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="A careful tool for powerful changes" FontSize="23" FontWeight="SemiBold" />
                        <TextBlock Text="CleanLens can start a registered uninstaller and move selected application data. Deep cleanup can affect software you still need. Personal files are not scanned or selected automatically." Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,12,0,16" />
                        <CheckBox IsChecked="{Binding SafetyAccepted}" FontSize="12"><TextBlock Text="I understand that cleanup can move application data and that restore may not work if the original path is occupied." TextWrapping="Wrap" Width="470" /></CheckBox>
                        <Button Content="Continue" Command="{Binding AcceptSafetyCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="0,20,0,0" />
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>
