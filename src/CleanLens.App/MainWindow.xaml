                                <CheckBox IsChecked="{Binding SafetyDamageAcknowledged}" FontSize="11"><TextBlock Text="{Binding Texts[SafetyCheckDamage]}" TextWrapping="Wrap" /></CheckBox>
                            </Border>
                            <Border Background="#FFF9F0" BorderBrush="#F0D5AB" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,4,0,4">
                                <CheckBox IsChecked="{Binding SafetyManualDeleteAcknowledged}" FontSize="11"><TextBlock Text="{Binding Texts[SafetyCheckManualDelete]}" TextWrapping="Wrap" /></CheckBox>
                            </Border>
                            <Border Background="#F8FAFC" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,4,0,4">
                                <CheckBox IsChecked="{Binding SafetyRestoreAcknowledged}" FontSize="11"><TextBlock Text="{Binding Texts[SafetyCheckRestore]}" TextWrapping="Wrap" /></CheckBox>
                            </Border>
                        </StackPanel>
                        <Button Content="{Binding Texts[Continue]}" Command="{Binding AcceptSafetyCommand}" IsEnabled="{Binding CanAcceptSafety}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="0,18,0,0" />
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>
