<Window x:Class="CleanLens.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:CleanLens.Core.Models;assembly=CleanLens.Core"
        Title="{Binding Texts[AppName]}" Icon="/CleanLens;component/Assets/CleanLens.ico" Width="1440" Height="920" MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="#F3F7FB" Foreground="{StaticResource InkBrush}" FontFamily="Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" BorderBrush="#19354E" BorderThickness="0,0,1,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#071827" Offset="0" />
                    <GradientStop Color="#0A2034" Offset="0.58" />
                    <GradientStop Color="#081A2B" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel Margin="17,22,17,18" LastChildFill="False">
                <Border DockPanel.Dock="Bottom" Background="#0E273D" BorderBrush="#1B3B55" BorderThickness="1" CornerRadius="16" Padding="13" Margin="0,13,0,0">
                    <StackPanel>
                        <Border HorizontalAlignment="Left" Background="#143550" CornerRadius="8" Padding="8,5">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="#55D1C8" VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBlock Text="{Binding Texts[LocalOnly]}" Foreground="#C3D7E7" FontSize="9" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding Texts[Principle]}" Foreground="#66D4D0" FontSize="8" FontWeight="Bold" Margin="1,13,0,0" />
                        <TextBlock Text="{Binding Texts[LocalTagline]}" Foreground="#D7E3ED" FontSize="11" TextWrapping="Wrap" LineHeight="16" Margin="1,5,0,0" />
                        <Button Click="OpenGitHub_Click" HorizontalAlignment="Stretch" Margin="0,13,0,0" Padding="10,8" Background="#163650" BorderBrush="#294A64" BorderThickness="1" Foreground="#DCEAF5" FontSize="11" FontWeight="SemiBold" Cursor="Hand">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="25" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#83B4D4" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="GitHub" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="↗" Foreground="#83B4D4" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>
                <Button x:Name="SettingsNav" DockPanel.Dock="Bottom" Style="{StaticResource NavButton}" Click="Settings_Click" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="11" Background="#122B41" Margin="0,0,12,0">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#AFC2D3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding Texts[Settings]}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Border DockPanel.Dock="Bottom" Height="1" Background="#20394F" Margin="0,12,0,0" />
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="3,2,0,27">
                        <Border Width="48" Height="48" CornerRadius="15" Background="#163852" BorderBrush="#2B526D" BorderThickness="1" Padding="3">
                            <Image Source="/CleanLens;component/logo.png" Stretch="Uniform" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="CleanLens" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Texts[ProductSubtitle]}" Foreground="#8FA8BF" FontSize="8" FontWeight="Bold" Margin="1,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Texts[Workspace]}" Foreground="#7890A8" FontSize="9" FontWeight="Bold" Margin="10,0,10,0" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Height="1" Background="#1C354A" VerticalAlignment="Center" Margin="5,0,4,0" />
                    </Grid>
                    <Button x:Name="ApplicationsNav" Style="{StaticResource NavButton}" Click="Applications_Click" Margin="0,2">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="11" Background="#122B41" Margin="0,0,12,0"><TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            <TextBlock Text="{Binding Texts[Applications]}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="LeftoversNav" Style="{StaticResource NavButton}" Click="Leftovers_Click" Margin="0,2">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="11" Background="#122B41" Margin="0,0,12,0"><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            <TextBlock Text="{Binding Texts[LeftoverReview]}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="HistoryNav" Style="{StaticResource NavButton}" Click="History_Click" Margin="0,2">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="11" Background="#122B41" Margin="0,0,12,0"><TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            <TextBlock Text="{Binding Texts[History]}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Grid Margin="0,22,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Texts[Protection]}" Foreground="#7890A8" FontSize="9" FontWeight="Bold" Margin="10,0,10,0" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Height="1" Background="#1C354A" VerticalAlignment="Center" Margin="5,0,4,0" />
                    </Grid>
                    <Button x:Name="QuarantineNav" Style="{StaticResource NavButton}" Click="Quarantine_Click" Margin="0,2">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="11" Background="#122B41" Margin="0,0,12,0"><TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            <TextBlock Text="{Binding Texts[Quarantine]}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="30,24,30,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,22">
                <Button DockPanel.Dock="Right" Content="{Binding Texts[ScanApplications]}" Command="{Binding ScanCommand}" Style="{StaticResource PrimaryButton}" />
                <StackPanel>
                    <TextBlock Text="{Binding PageTitle}" FontSize="27" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding PageSubtitle}" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>
            <Grid x:Name="SummaryMetrics" Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="17,14"><StackPanel><TextBlock Text="{Binding Texts[InstalledApps]}" FontSize="10" Foreground="{StaticResource MutedBrush}" FontWeight="Bold" /><TextBlock Text="{Binding AppCountText}" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0" /></StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="17,14"><StackPanel><TextBlock Text="{Binding Texts[ReportedAppSize]}" FontSize="10" Foreground="{StaticResource MutedBrush}" FontWeight="Bold" /><TextBlock Text="{Binding TotalSizeText}" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0" /><TextBlock Text="{Binding Texts[ReportedEstimateNote]}" FontSize="9" Foreground="{StaticResource MutedBrush}" /></StackPanel></Border>
                <Border Grid.Column="4" Style="{StaticResource Card}" Padding="17,14"><StackPanel><TextBlock Text="{Binding Texts[CandidatesFound]}" FontSize="10" Foreground="{StaticResource MutedBrush}" FontWeight="Bold" /><TextBlock Text="{Binding LeftoversText}" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0" /></StackPanel></Border>
            </Grid>
            <Grid Grid.Row="2" x:Name="ApplicationWorkspace">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="235" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="158" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="184" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SearchBox" Grid.Column="0" Height="38" Padding="11,0" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" TextChanged="Search_Changed" ToolTip="{Binding Texts[SearchTooltip]}" />
                            <ComboBox x:Name="SearchScopeCombo" Grid.Column="2" Height="38" SelectedIndex="0" SelectionChanged="SearchScope_Changed">
                                <ComboBoxItem Content="{Binding Texts[SearchAllFields]}" />
                                <ComboBoxItem Content="{Binding Texts[SearchName]}" />
                                <ComboBoxItem Content="{Binding Texts[SearchPublisher]}" />
                                <ComboBoxItem Content="{Binding Texts[SearchVersion]}" />
                                <ComboBoxItem Content="{Binding Texts[SearchLocation]}" />
                            </ComboBox>
                            <ComboBox x:Name="FilterCombo" Grid.Column="4" Width="184" Height="38" HorizontalAlignment="Right" SelectedIndex="0" SelectionChanged="Filter_Changed">
                                <ComboBoxItem Content="{Binding Texts[AllApplications]}" />
                                <ComboBoxItem Content="{Binding Texts[HasUninstaller]}" />
                                <ComboBoxItem Content="{Binding Texts[WithoutUninstaller]}" />
                                <ComboBoxItem Content="{Binding Texts[KnownPublisher]}" />
                                <ComboBoxItem Content="{Binding Texts[UnknownPublisher]}" />
                                <ComboBoxItem Content="{Binding Texts[ReportedSize]}" />
                                <ComboBoxItem Content="{Binding Texts[UnreportedSize]}" />
                            </ComboBox>
                        </Grid>
                        <DataGrid x:Name="ApplicationsDataGrid" Grid.Row="1" ItemsSource="{Binding VisibleApplications}" SelectedItem="{Binding SelectedApplication, Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="True" Sorting="ApplicationsDataGrid_Sorting" ColumnHeaderStyle="{StaticResource SortableColumnHeader}" IsReadOnly="True" HeadersVisibility="Column" RowHeight="55" ColumnHeaderHeight="40" Background="Transparent">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="54" CanUserSort="False" HeaderStyle="{StaticResource NonSortableColumnHeader}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Width="35" Height="35" CornerRadius="11" Background="{StaticResource AccentSoft}" HorizontalAlignment="Center" AutomationProperties.Name="{Binding Name}">
                                                <Grid>
                                                    <TextBlock Text="{Binding Name, Converter={StaticResource ApplicationMonogramConverter}}" Foreground="{StaticResource BlueBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <Image Source="{Binding DisplayIcon, Converter={StaticResource ApplicationIconConverter}}" Stretch="Uniform" Margin="5" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="APPLICATION" SortMemberPath="Name" Binding="{Binding Name}" ElementStyle="{StaticResource ApplicationNameCell}" Width="2*" />
                                <DataGridTextColumn Header="PUBLISHER" SortMemberPath="Publisher" Binding="{Binding Publisher}" ElementStyle="{StaticResource PublisherCell}" Width="1.4*" MinWidth="150" />
                                <DataGridTextColumn Header="VERSION" SortMemberPath="Version" Binding="{Binding Version}" ElementStyle="{StaticResource VersionCell}" Width="1.1*" MinWidth="110" />
                                <DataGridTemplateColumn Header="SIZE · EST." SortMemberPath="EstimatedSizeKilobytes" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                                <TextBlock Text="{Binding EstimatedSizeText}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SizeCell}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding EstimatedSizeKilobytes}" Value="{x:Null}">
                                                                    <Setter Property="Text" Value="{Binding DataContext.Texts[SizeNotReported], RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Row="1" Background="#FFFCFE" CornerRadius="14" Margin="8" Visibility="{Binding InventoryEmptyStateVisibility}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="390">
                                <Border Width="54" Height="54" CornerRadius="17" Background="{StaticResource AccentSoft}" HorizontalAlignment="Center" Margin="0,0,0,16">
                                    <TextBlock Text="⌕" FontSize="29" Foreground="{StaticResource BlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding InventoryEmptyTitle}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" />
                                <TextBlock Text="{Binding InventoryEmptyCopy}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,7,0,18" />
                                <Button Content="{Binding Texts[ScanApplications]}" Command="{Binding ScanCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Center" Visibility="{Binding InventoryEmptyScanVisibility}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Width="48" Height="48" CornerRadius="16" Background="#EAF2FF" HorizontalAlignment="Left">
                                <Canvas Width="35" Height="35" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="M 3,17 C 9,6 26,6 32,17 C 26,28 9,28 3,17 Z" Stroke="{StaticResource BlueBrush}" StrokeThickness="2" />
                                    <Ellipse Canvas.Left="13" Canvas.Top="12" Width="9" Height="9" Fill="{StaticResource InkBrush}" />
                                    <Path Data="M 21,21 L 28,28" Stroke="{StaticResource TealBrush}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Canvas>
                            </Border>
                            <TextBlock Text="{Binding SelectedApplicationDisplayName}" FontSize="23" FontWeight="SemiBold" Margin="0,16,0,3" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedPublisher}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                            <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,18" />
                            <TextBlock Text="{Binding Texts[ApplicationDetails]}" FontSize="10" Foreground="{StaticResource MutedBrush}" FontWeight="Bold" />
                            <TextBlock Text="{Binding DetailVersion}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding DetailLocation}" FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding DetailSource}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0" />
                            <Button Content="{Binding Texts[MeasureDiskUsage]}" Click="MeasureDiskUsage_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" Margin="0,10,0,0" />
                            <Expander Header="{Binding Texts[AdvancedDetails]}" Margin="0,14,0,0">
                                <StackPanel Margin="0,9,0,0">
                                    <TextBlock Text="{Binding Texts[UninstallCommand]}" FontWeight="SemiBold" FontSize="11" />
                                    <TextBlock Text="{Binding SelectedApplication.UninstallCommand}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,9" />
                                    <TextBlock Text="{Binding Texts[RegistryIdentity]}" FontWeight="SemiBold" FontSize="11" />
                                    <TextBlock Text="{Binding SelectedApplication.RegistryKeyPath}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,9" />
                                </StackPanel>
                            </Expander>
                            <Border Background="#F2F7FC" CornerRadius="12" Padding="13" Margin="0,15,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Texts[PersonalDataOut]}" Foreground="#177C75" FontWeight="Bold" FontSize="9" />
                                    <TextBlock Text="{Binding Texts[PersonalDataMessage]}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <Button Content="{Binding UninstallButtonText}" Click="Uninstall_Click" IsEnabled="{Binding CanUninstallSelected}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Margin="0,18,0,0" />
                            <Button Content="{Binding Texts[ReviewLeftovers]}" Click="Leftovers_Click" IsEnabled="{Binding CanReviewLeftovers}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" Margin="0,8,0,0" />
                            <Button Content="{Binding Texts[ManualDelete]}" Click="ManualDelete_Click" IsEnabled="{Binding SafetyAccepted}" Style="{StaticResource SecondaryButton}" Background="#B4233D" BorderBrush="#B4233D" Foreground="White" HorizontalAlignment="Stretch" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,11,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
            <Border Grid.Row="2" x:Name="LeftoverWorkspace" Style="{StaticResource Card}" Visibility="Collapsed">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
                        <Button Content="{Binding Texts[ScanSelectedApplication]}" Command="{Binding ScanLeftoversCommand}" IsEnabled="{Binding CanReviewLeftovers}" Style="{StaticResource PrimaryButton}" />
                        <Button Content="{Binding Texts[MoveToQuarantine]}" Click="QuarantineSelected_Click" IsEnabled="{Binding CanQuarantineSelected}" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" />
                    </StackPanel>
                    <Grid>
                    <DataGrid x:Name="LeftoversDataGrid" ItemsSource="{Binding Leftovers}" SelectedItem="{Binding SelectedLeftover, Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" RowHeight="58" ColumnHeaderHeight="40" Background="Transparent">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PATH" Binding="{Binding Path}" Width="3*" />
                            <DataGridTextColumn Header="SIZE" Binding="{Binding SizeText}" Width="90" />
                            <DataGridTemplateColumn Header="TYPE" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource LocalizationValueConverter}" ConverterParameter="Category">
                                                    <Binding Path="Category" />
                                                    <Binding Path="DataContext.Texts.Language" RelativeSource="{RelativeSource AncestorType={x:Type DataGrid}}" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="CONFIDENCE" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource LocalizationValueConverter}" ConverterParameter="Confidence">
                                                    <Binding Path="Confidence" />
                                                    <Binding Path="DataContext.Texts.Language" RelativeSource="{RelativeSource AncestorType={x:Type DataGrid}}" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="REASON" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock TextWrapping="Wrap">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource LocalizationValueConverter}" ConverterParameter="Candidate">
                                                    <Binding Path="ReasonKey" />
                                                    <Binding Path="DataContext.Texts.Language" RelativeSource="{RelativeSource AncestorType={x:Type DataGrid}}" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Background="#FFFCFE" CornerRadius="14" Margin="8" Visibility="{Binding LeftoversEmptyStateVisibility}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="390">
                            <Border Width="54" Height="54" CornerRadius="17" Background="{StaticResource AccentSoft}" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <TextBlock Text="⌕" FontSize="29" Foreground="{StaticResource BlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding LeftoversEmptyTitle}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" />
                            <TextBlock Text="{Binding LeftoversEmptyCopy}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,7,0,0" />
                        </StackPanel>
                    </Border>
                    </Grid>
                </DockPanel>
            </Border>
            <Border Grid.Row="2" x:Name="HistoryWorkspace" Style="{StaticResource Card}" Visibility="Collapsed">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Texts[HistoryTitle]}" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,14" />
                    <Grid>
                    <ListBox ItemsSource="{Binding HistoryEntries}" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="5,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="{Binding ApplicationName}" FontWeight="SemiBold" /><TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"><Run Text="{Binding Operation}" /><Run Text=" · " /><Run Text="{Binding Result}" /></TextBlock></StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding CreatedAt, StringFormat={}{0:g}}" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center" Margin="12,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Background="#FFFCFE" CornerRadius="14" Margin="8" Visibility="{Binding HistoryEmptyStateVisibility}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="390">
                            <Border Width="54" Height="54" CornerRadius="17" Background="{StaticResource AccentSoft}" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <TextBlock Text="◷" FontSize="25" Foreground="{StaticResource BlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding Texts[EmptyHistoryTitle]}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" />
                            <TextBlock Text="{Binding Texts[EmptyHistoryCopy]}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,7,0,0" />
                        </StackPanel>
                    </Border>
                    </Grid>
                </DockPanel>
            </Border>
            <Border Grid.Row="2" x:Name="QuarantineWorkspace" Style="{StaticResource Card}" Visibility="Collapsed">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="{Binding Texts[QuarantinedItems]}" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Content="{Binding Texts[RestoreSelected]}" Click="RestoreSelected_Click" IsEnabled="{Binding CanRestoreSelected}" Style="{StaticResource SecondaryButton}" Margin="18,0,0,0" />
                    </StackPanel>
                    <Grid>
                    <ListBox ItemsSource="{Binding QuarantineEntries}" SelectedItem="{Binding SelectedQuarantine, Mode=TwoWay}" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="5,12">
                                    <StackPanel><TextBlock Text="{Binding ApplicationName}" FontWeight="SemiBold" /><TextBlock Text="{Binding OriginalPath}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap" /><TextBlock Text="{Binding CreatedAt, StringFormat={}{0:g}}" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" /></StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Background="#FFFCFE" CornerRadius="14" Margin="8" Visibility="{Binding QuarantineEmptyStateVisibility}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="390">
                            <Border Width="54" Height="54" CornerRadius="17" Background="{StaticResource AccentSoft}" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <TextBlock Text="▣" FontSize="25" Foreground="{StaticResource BlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding Texts[EmptyQuarantineTitle]}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" />
                            <TextBlock Text="{Binding Texts[EmptyQuarantineCopy]}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,7,0,0" />
                        </StackPanel>
                    </Border>
                    </Grid>
                </DockPanel>
            </Border>
            <Border Grid.Row="2" x:Name="SettingsWorkspace" Style="{StaticResource Card}" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="840" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding Texts[PreferencesHeading]}" FontSize="10" Foreground="{StaticResource BlueBrush}" FontWeight="Bold" />
                        <Grid Margin="0,9,0,4" MinHeight="60">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                                <TextBlock Text="{Binding Texts[Language]}" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Texts[SettingsSubtitle]}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                            <ComboBox x:Name="LanguageSelector" Grid.Column="1" SelectedValue="{Binding SelectedLanguage, Mode=OneWay}" SelectedValuePath="Tag" SelectionChanged="Language_Changed" Width="190" Height="42" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <ComboBoxItem Content="English" Tag="en" />
                                <ComboBoxItem Content="Italiano" Tag="it" />
                                <ComboBoxItem Content="Español" Tag="es" />
                                <ComboBoxItem Content="Français" Tag="fr" />
                            </ComboBox>
                        </Grid>
                        <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,24,0,22" />
                        <TextBlock Text="{Binding Texts[InstallMonitorHeading]}" FontSize="10" Foreground="{StaticResource BlueBrush}" FontWeight="Bold" />
                        <TextBlock Text="{Binding Texts[InstallMonitorDescription]}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,12" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{Binding Texts[StartMonitor]}" Click="StartMonitor_Click" IsEnabled="{Binding CanStartInstallMonitor}" Style="{StaticResource PrimaryButton}" />
                            <Button Content="{Binding Texts[StopMonitor]}" Click="StopMonitor_Click" IsEnabled="{Binding CanStopInstallMonitor}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding InstallMonitorResults}" MaxHeight="260" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11" Margin="0,3" /></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,24,0,22" />
                        <TextBlock Text="{Binding Texts[DataStorageHeading]}" FontSize="10" Foreground="{StaticResource BlueBrush}" FontWeight="Bold" />
                        <TextBlock Text="{Binding Texts[DataStorageDescription]}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,8" />
                        <TextBlock Text="{Binding LocalDataPath}" FontSize="12" FontFamily="Cascadia Code" TextWrapping="Wrap" />
                        <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,24,0,22" />
                        <TextBlock Text="{Binding Texts[CustomSearchRootsHeading]}" FontSize="10" Foreground="{StaticResource BlueBrush}" FontWeight="Bold" />
                        <TextBlock Text="{Binding Texts[CustomSearchRootsDescription]}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,12" />
                        <Button Content="{Binding Texts[AddSearchRoot]}" Click="AddSearchRoot_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" />
                        <ItemsControl ItemsSource="{Binding ManualSearchRoots}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F8FAFC" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="10,7" Margin="0,3">
                                        <DockPanel LastChildFill="True">
                                            <Button DockPanel.Dock="Right" Content="{Binding DataContext.RemoveSearchRootText, RelativeSource={RelativeSource AncestorType=Window}}" Visibility="{Binding RemoveVisibility}" Tag="{Binding}" Click="RemoveSearchRoot_Click" Style="{StaticResource SecondaryButton}" Padding="10,5" Margin="8,0,0,0" />
                                            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <TextBlock Text="{Binding DisplayPath}" VerticalAlignment="Center" TextWrapping="Wrap" FontFamily="Cascadia Code" FontSize="11" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,24,0,22" />
                        <TextBlock Text="{Binding Texts[LocalPrivacyHeading]}" FontSize="10" Foreground="{StaticResource BlueBrush}" FontWeight="Bold" />
                        <TextBlock Text="{Binding Texts[LocalPrivacyDescription]}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0" />
                        <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,24,0,22" />
                        <TextBlock Text="{Binding Texts[SafetySettingsHeading]}" FontSize="10" Foreground="{StaticResource BlueBrush}" FontWeight="Bold" />
                        <TextBlock Text="{Binding Texts[SafetySettingsDescription]}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,12" />
                        <Button Content="{Binding Texts[ReviewSafetyNotice]}" Command="{Binding ReviewSafetyNoticeCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" />
                        <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,24,0,22" />
                        <TextBlock Text="{Binding Texts[AboutHeading]}" FontSize="10" Foreground="{StaticResource BlueBrush}" FontWeight="Bold" />
                        <TextBlock Text="{Binding Texts[ProjectVersion]}" FontSize="12" Margin="0,7,0,3" />
                        <TextBlock Text="{Binding Texts[LicenseDescription]}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Border Grid.RowSpan="3" Background="#99081A2C" Visibility="{Binding DisclaimerVisibility}">
                <Border Width="680" Padding="30" Background="White" CornerRadius="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="{Binding Texts[SafetyTitle]}" FontSize="23" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Texts[SafetyBody]}" Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,12,0,16" />
                        <StackPanel>
                            <Border Background="#F8FAFC" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,4,0,4">
                                <CheckBox IsChecked="{Binding SafetyUninstallerAcknowledged}" FontSize="11"><TextBlock Text="{Binding Texts[SafetyCheckUninstaller]}" TextWrapping="Wrap" /></CheckBox>
                            </Border>
                            <Border Background="#F8FAFC" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,4,0,4">
                                <CheckBox IsChecked="{Binding SafetyDamageAcknowledged}" FontSize="11"><TextBlock Text="{Binding Texts[SafetyCheckDamage]}" TextWrapping="Wrap" /></CheckBox>
                            </Border>
                            <Border Background="#FFF9F0" BorderBrush="#F0D5AB" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,4,0,4">
                                <CheckBox IsChecked="{Binding SafetyManualDeleteAcknowledged}" FontSize="11"><TextBlock Text="{Binding Texts[SafetyCheckManualDelete]}" TextWrapping="Wrap" /></CheckBox>
                            </Border>
                            <Border Background="#F8FAFC" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,4,0,4">
                                <CheckBox IsChecked="{Binding SafetyRestoreAcknowledged}" FontSize="11"><TextBlock Text="{Binding Texts[SafetyCheckRestore]}" TextWrapping="Wrap" /></CheckBox>
                            </Border>
                        </StackPanel>
                        <Button Content="{Binding Texts[Continue]}" Command="{Binding AcceptSafetyCommand}" IsEnabled="{Binding CanAcceptSafety}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="0,18,0,0" />
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>
