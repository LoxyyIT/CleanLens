<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>CleanLens.App</RootNamespace>
    <AssemblyName>CleanLens</AssemblyName>
    <ApplicationIcon>Assets\CleanLens.ico</ApplicationIcon>
    <Version>0.1.1</Version>
    <AssemblyVersion>0.1.1.0</AssemblyVersion>
    <FileVersion>0.1.1.0</FileVersion>
    <InformationalVersion>0.1.1</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="..\..\logo.png" Link="logo.png" />
    <Resource Include="Assets\CleanLens.ico" />
    <ProjectReference Include="..\CleanLens.Core\CleanLens.Core.csproj" />
    <ProjectReference Include="..\CleanLens.Windows\CleanLens.Windows.csproj" />
    <ProjectReference Include="..\CleanLens.Data\CleanLens.Data.csproj" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
  </ItemGroup>
</Project>
