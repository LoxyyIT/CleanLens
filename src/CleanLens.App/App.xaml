<Application x:Class="CleanLens.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CleanLens.App">
    <Application.Resources>
        <ResourceDictionary>
            <local:LocalizationValueConverter x:Key="LocalizationValueConverter" />
            <local:ApplicationMonogramConverter x:Key="ApplicationMonogramConverter" />
            <local:ApplicationIconConverter x:Key="ApplicationIconConverter" />
            <local:DiskEntryIconConverter x:Key="DiskEntryIconConverter" />
            <Color x:Key="Ink">#101F35</Color>
            <Color x:Key="Muted">#60738B</Color>
            <Color x:Key="Line">#DCE6F1</Color>
            <Color x:Key="Soft">#F0F5FB</Color>
            <Color x:Key="Navy">#071725</Color>
            <Color x:Key="NavySecondary">#102A42</Color>
            <Color x:Key="NavyCard">#173D58</Color>
            <Color x:Key="Blue">#315FF4</Color>
            <Color x:Key="Cyan">#10B3C7</Color>
            <Color x:Key="Teal">#099C91</Color>
            <Color x:Key="AccentSoftColor">#EEF3FF</Color>
            <SolidColorBrush x:Key="InkBrush" Color="{StaticResource Ink}" />
            <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource Muted}" />
            <SolidColorBrush x:Key="LineBrush" Color="{StaticResource Line}" />
            <SolidColorBrush x:Key="SoftBrush" Color="{StaticResource Soft}" />
            <SolidColorBrush x:Key="NavyBrush" Color="{StaticResource Navy}" />
            <SolidColorBrush x:Key="NavySecondaryBrush" Color="{StaticResource NavySecondary}" />
            <SolidColorBrush x:Key="NavyCardBrush" Color="{StaticResource NavyCard}" />
            <SolidColorBrush x:Key="BlueBrush" Color="{StaticResource Blue}" />
            <SolidColorBrush x:Key="CyanBrush" Color="{StaticResource Cyan}" />
            <SolidColorBrush x:Key="TealBrush" Color="{StaticResource Teal}" />
            <SolidColorBrush x:Key="AccentSoft" Color="{StaticResource AccentSoftColor}" />
            <DropShadowEffect x:Key="CardShadow" BlurRadius="32" ShadowDepth="5" Direction="270" Opacity="0.09" Color="#19375B" />

            <ControlTemplate x:Key="BareToggleButton" TargetType="ToggleButton">
                <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" ContentStringFormat="{TemplateBinding ContentStringFormat}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
            </ControlTemplate>

            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
            </Style>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="White" />
                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="22" />
                <Setter Property="Padding" Value="22" />
                <Setter Property="Effect" Value="{StaticResource CardShadow}" />
            </Style>

            <Style x:Key="SectionEyebrow" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Margin" Value="1,0,0,7" />
            </Style>

            <Style x:Key="StatusPill" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource AccentSoft}" />
                <Setter Property="BorderBrush" Value="#D8E5F7" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="9,5" />
            </Style>

            <Style x:Key="AnalysisEmptySurface" TargetType="Border">
                <Setter Property="Background" Value="#F8FAFD" />
                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="30" />
            </Style>

            <Style x:Key="SettingsPanel" TargetType="Border">
                <Setter Property="Background" Value="#F8FAFD" />
                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="19" />
                <Setter Property="Margin" Value="0,0,0,13" />
            </Style>

            <Style x:Key="NavButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#B8C9DA" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="MinHeight" Value="49" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="NavSurface" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="14" />
                                <Border x:Name="ActiveMark" Width="4" HorizontalAlignment="Left" Margin="1,10,0,10" Background="{StaticResource CyanBrush}" CornerRadius="3" Visibility="Collapsed" />
                                <Border x:Name="KeyboardFocusRing" BorderBrush="#55738F" BorderThickness="1" CornerRadius="12" Opacity="0" IsHitTestVisible="False" />
                                <ContentPresenter Margin="3,0,2,0" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="NavSurface" Property="Background" Value="#153149" />
                                    <Setter TargetName="NavSurface" Property="BorderBrush" Value="#284963" />
                                    <Setter Property="Foreground" Value="#EDF5FC" />
                                </Trigger>
                                <Trigger Property="Tag" Value="Active">
                                    <Setter TargetName="NavSurface" Property="Background" Value="#1C405D" />
                                    <Setter TargetName="NavSurface" Property="BorderBrush" Value="#37627E" />
                                    <Setter TargetName="ActiveMark" Property="Visibility" Value="Visible" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="KeyboardFocusRing" Property="Opacity" Value="1" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="NavSurface" Property="Background" Value="#214966" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.48" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="RepeatButton" x:Key="ScrollBarTrackButton">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border Background="Transparent" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="Thumb" x:Key="ScrollBarThumb">
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="MinWidth" Value="28" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border x:Name="ThumbSurface" Background="#BCC9D7" CornerRadius="5" Margin="2" />
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbSurface" Property="Background" Value="#8295AA" /></Trigger>
                                <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbSurface" Property="Background" Value="#396BE8" /></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ThumbSurface" Property="Opacity" Value="0.35" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ScrollBar">
                <Setter Property="Width" Value="11" />
                <Setter Property="MinWidth" Value="11" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid x:Name="ScrollBarSurface" Background="Transparent" SnapsToDevicePixels="True">
                                <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True" Focusable="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton x:Name="DecreaseButton" Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource ScrollBarTrackButton}" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb><Thumb Style="{StaticResource ScrollBarThumb}" /></Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton x:Name="IncreaseButton" Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource ScrollBarTrackButton}" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Orientation" Value="Horizontal">
                                    <Setter Property="Height" Value="11" />
                                    <Setter Property="Width" Value="Auto" />
                                    <Setter TargetName="DecreaseButton" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}" />
                                    <Setter TargetName="IncreaseButton" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}" />
                                    <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ScrollBarSurface" Property="Background" Value="#F3F7FB" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource BlueBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="19,12" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="PrimarySurface" Background="{TemplateBinding Background}" CornerRadius="11" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PrimarySurface" Property="Background" Value="#244BD1" /></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="PrimarySurface" Property="Opacity" Value="0.82" /></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="PrimarySurface" Property="Opacity" Value="0.45" /></Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="PrimarySurface" Property="BorderBrush" Value="#7DD2D8" /><Setter TargetName="PrimarySurface" Property="BorderThickness" Value="2" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SecondaryButton" TargetType="Button">
                <Setter Property="Background" Value="White" />
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="SecondarySurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SecondarySurface" Property="Background" Value="{StaticResource AccentSoft}" /><Setter TargetName="SecondarySurface" Property="BorderBrush" Value="{StaticResource BlueBrush}" /></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="SecondarySurface" Property="Opacity" Value="0.78" /></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="SecondarySurface" Property="Opacity" Value="0.48" /></Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SecondarySurface" Property="BorderBrush" Value="{StaticResource BlueBrush}" /><Setter TargetName="SecondarySurface" Property="BorderThickness" Value="2" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="WindowCaptionButton" TargetType="Button">
                <Setter Property="Width" Value="46" />
                <Setter Property="Height" Value="52" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#C8D7E5" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="CaptionSurface" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CaptionSurface" Property="Background" Value="#16344C" /><Setter Property="Foreground" Value="White" /></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="CaptionSurface" Property="Background" Value="#214A66" /></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="CaptionSurface" Property="Opacity" Value="0.45" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="WindowCloseButton" TargetType="Button" BasedOn="{StaticResource WindowCaptionButton}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="CaptionSurface" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CaptionSurface" Property="Background" Value="#C93645" /><Setter Property="Foreground" Value="White" /></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="CaptionSurface" Property="Background" Value="#A92735" /></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="CaptionSurface" Property="Opacity" Value="0.45" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}" />

            <Style TargetType="TextBox">
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                <Setter Property="Background" Value="White" />
                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Grid ClipToBounds="True">
                                <Border x:Name="InputSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                                    <Grid>
                                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                        <TextBlock x:Name="Watermark" Text="{TemplateBinding ToolTip}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Foreground="{StaticResource MutedBrush}" Opacity="0.72" IsHitTestVisible="False" Visibility="Collapsed" />
                                    </Grid>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Text" Value=""><Setter TargetName="Watermark" Property="Visibility" Value="Visible" /></Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="InputSurface" Property="BorderBrush" Value="{StaticResource BlueBrush}" /><Setter TargetName="InputSurface" Property="BorderThickness" Value="1.5" /></Trigger>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="InputSurface" Property="BorderBrush" Value="#A8BCD0" /></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="InputSurface" Property="Opacity" Value="0.55" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                <Setter Property="Padding" Value="11,8" />
                <Setter Property="Margin" Value="3,2" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="ItemSurface" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="{StaticResource AccentSoft}" /><Setter Property="Foreground" Value="{StaticResource BlueBrush}" /></Trigger>
                                <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#E8F0FF" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ComboBox">
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                <Setter Property="Background" Value="White" />
                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="11,7" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton x:Name="DropToggle" Template="{StaticResource BareToggleButton}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Focusable="False" ClickMode="Press" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0">
                                    <Border x:Name="ComboSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /></Grid.ColumnDefinitions>
                                            <ContentPresenter Grid.Column="0" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                            <Path Grid.Column="1" Data="M 2,3 L 6,7 L 10,3" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.5" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </ToggleButton>
                                <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade" StaysOpen="False">
                                    <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="300" Margin="0,6,0,0" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="11" Effect="{StaticResource CardShadow}">
                                        <ScrollViewer Margin="3" CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboSurface" Property="BorderBrush" Value="#A8BCD0" /></Trigger>
                                <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="ComboSurface" Property="BorderBrush" Value="{StaticResource BlueBrush}" /></Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ComboSurface" Property="BorderBrush" Value="{StaticResource BlueBrush}" /></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ComboSurface" Property="Opacity" Value="0.5" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="29" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border x:Name="CheckSurface" Width="17" Height="17" Background="White" BorderBrush="#B9C7D5" BorderThickness="1.2" CornerRadius="5" VerticalAlignment="Top" Margin="0,2,0,0">
                                    <Path x:Name="CheckMark" Data="M 3,8 L 6.5,11 L 13,4" Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Top" RecognizesAccessKey="True" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckSurface" Property="Background" Value="{StaticResource BlueBrush}" /><Setter TargetName="CheckSurface" Property="BorderBrush" Value="{StaticResource BlueBrush}" /><Setter TargetName="CheckMark" Property="Visibility" Value="Visible" /></Trigger>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckSurface" Property="BorderBrush" Value="{StaticResource BlueBrush}" /></Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CheckSurface" Property="BorderBrush" Value="{StaticResource BlueBrush}" /><Setter TargetName="CheckSurface" Property="BorderThickness" Value="2" /></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="Expander">
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Expander">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <ToggleButton x:Name="ExpanderToggle" Grid.Row="0" Template="{StaticResource BareToggleButton}" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Background="Transparent" BorderThickness="0" Padding="0,7" HorizontalContentAlignment="Stretch">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Border Width="17" Height="17" CornerRadius="6" Background="{StaticResource SoftBrush}" VerticalAlignment="Center">
                                            <Path x:Name="ExpanderArrow" Data="M 4,2 L 8,6 L 12,2" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ContentPresenter Grid.Column="1" Content="{TemplateBinding Header}" VerticalAlignment="Center" RecognizesAccessKey="True" />
                                    </Grid>
                                </ToggleButton>
                                <ContentPresenter x:Name="ExpanderContent" Grid.Row="1" ContentSource="Content" Margin="22,8,0,0" Visibility="Collapsed" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsExpanded" Value="True">
                                    <Setter TargetName="ExpanderContent" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="ExpanderArrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180" CenterX="8" CenterY="4" /></Setter.Value></Setter>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ExpanderArrow" Property="Stroke" Value="{StaticResource BlueBrush}" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="DataGrid">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="RowBackground" Value="White" />
                <Setter Property="AlternatingRowBackground" Value="#F8FAFD" />
                <Setter Property="HeadersVisibility" Value="Column" />
                <Setter Property="GridLinesVisibility" Value="None" />
                <Setter Property="SelectionUnit" Value="FullRow" />
                <Setter Property="SelectionMode" Value="Single" />
                <Setter Property="CanUserAddRows" Value="False" />
                <Setter Property="CanUserResizeRows" Value="False" />
                <Setter Property="RowHeaderWidth" Value="0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="AlternationCount" Value="2" />
                <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            </Style>

            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#F4F7FC" />
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="Height" Value="43" />
                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
            </Style>

            <Style x:Key="SortableColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="ToolTip" Value="{Binding DataContext.Texts[SortableColumnTooltip], RelativeSource={RelativeSource AncestorType=Window}}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridColumnHeader">
                            <Border x:Name="HeaderSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                <DockPanel LastChildFill="True" VerticalAlignment="Center">
                                    <TextBlock x:Name="SortGlyph" DockPanel.Dock="Right" Text="↕" Foreground="#9AAABD" FontSize="12" FontWeight="SemiBold" Margin="10,0,2,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                    <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" ContentStringFormat="{TemplateBinding ContentStringFormat}" VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" RecognizesAccessKey="True" />
                                </DockPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="HeaderSurface" Property="Background" Value="#EEF4FF" />
                                    <Setter Property="Foreground" Value="{StaticResource BlueBrush}" />
                                    <Setter TargetName="SortGlyph" Property="Foreground" Value="{StaticResource BlueBrush}" />
                                    <Setter TargetName="SortGlyph" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <DataTrigger Binding="{Binding SortDirection, RelativeSource={RelativeSource TemplatedParent}}" Value="Ascending">
                                    <Setter TargetName="SortGlyph" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SortDirection, RelativeSource={RelativeSource TemplatedParent}}" Value="Descending">
                                    <Setter TargetName="SortGlyph" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="HeaderSurface" Property="BorderBrush" Value="{StaticResource BlueBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="NonSortableColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}" />

            <Style TargetType="DataGridCell">
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                <Setter Property="Padding" Value="14,7" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent" /></Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="GridTextCell" TargetType="TextBlock">
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="ApplicationNameCell" TargetType="TextBlock" BasedOn="{StaticResource GridTextCell}">
                <Setter Property="ToolTip" Value="{Binding Name}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="13" />
            </Style>
            <Style x:Key="PublisherCell" TargetType="TextBlock" BasedOn="{StaticResource GridTextCell}">
                <Setter Property="ToolTip" Value="{Binding Publisher}" />
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="VersionCell" TargetType="TextBlock" BasedOn="{StaticResource GridTextCell}">
                <Setter Property="ToolTip" Value="{Binding Version}" />
                <Setter Property="FontSize" Value="11.5" />
            </Style>
            <Style x:Key="SizeCell" TargetType="TextBlock" BasedOn="{StaticResource GridTextCell}">
                <Setter Property="TextAlignment" Value="Right" />
                <Setter Property="ToolTip" Value="{Binding EstimatedSizeText}" />
            </Style>

            <Style TargetType="DataGridRow">
                <Setter Property="MinHeight" Value="62" />
                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource Self}}" Value="1"><Setter Property="Background" Value="#F8FAFD" /></DataTrigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#EFF5FF" /><Setter Property="BorderBrush" Value="#C7D9F8" /></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#E7EFFF" /><Setter Property="BorderBrush" Value="#ADC6FC" /></Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="ListBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            </Style>

            <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="10,7" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="ListItemSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="11" Padding="{TemplateBinding Padding}" Margin="0,2">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ListItemSurface" Property="Background" Value="{StaticResource SoftBrush}" /><Setter TargetName="ListItemSurface" Property="BorderBrush" Value="{StaticResource LineBrush}" /></Trigger>
                                <Trigger Property="IsSelected" Value="True"><Setter TargetName="ListItemSurface" Property="Background" Value="{StaticResource AccentSoft}" /><Setter TargetName="ListItemSurface" Property="BorderBrush" Value="#BBD0FF" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="TabControl">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
            </Style>
            <Style TargetType="TabItem">
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="18,13" />
                <Setter Property="Margin" Value="0,0,9,0" />
                <Setter Property="MinHeight" Value="49" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="TabSurface" Background="White" BorderBrush="#AEBFD4" BorderThickness="1,1,2,1" CornerRadius="13" Padding="{TemplateBinding Padding}" Margin="0,0,3,0" SnapsToDevicePixels="True" UseLayoutRounding="True">
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#F4F7FF" /><Setter TargetName="TabSurface" Property="BorderBrush" Value="#9FB9E8" /><Setter Property="Foreground" Value="{StaticResource BlueBrush}" /></Trigger>
                                <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{StaticResource AccentSoft}" /><Setter TargetName="TabSurface" Property="BorderBrush" Value="#6386F0" /><Setter TargetName="TabSurface" Property="BorderThickness" Value="1,1,2,1" /><Setter Property="Foreground" Value="{StaticResource BlueBrush}" /></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
